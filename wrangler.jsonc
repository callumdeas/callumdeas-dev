// callumdeas.dev on Cloudflare Workers, via the OpenNext adapter
// (@opennextjs/cloudflare; config in open-next.config.ts).
//
//   pnpm preview   → build, serve locally with wrangler dev (http://localhost:8787)
//   pnpm deploy:cf → build and deploy to callumdeas-dev.<subdomain>.workers.dev
//
// No routes / custom domains yet: callumdeas.dev is still served by Railway.
// Cutover = add `"routes": [{ "pattern": "www.callumdeas.dev", "custom_domain": true }]`
// (and the apex, or keep the apex → www redirect) once DNS is ready.
//
// NO .env FILES IN THE BUNDLE. OpenNext copies every .env* value it finds at
// build time into the Worker; scripts/cf-build.mjs empties that copy and fails
// the build if any local .env value still appears in .open-next/. The site reads
// no env vars at runtime; if it ever needs one, add it to `vars` here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "callumdeas-dev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" }
}
